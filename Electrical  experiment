#include <stdio.h>

void main()

{

int i;

float current, resistance, voltage;

for(i = 1; i <= 5; i++)

{

printf("\nExperiment %d\n", i);

printf("Enter current (A): ");

scanf("%f", &current);

printf("Enter resistance (Ohms): ");

scanf("%f", &resistance);

voltage = current * resistance;

printf("Voltage = %.2f V\n", voltage);

}

}